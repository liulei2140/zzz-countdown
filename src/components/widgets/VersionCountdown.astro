---
/**
 * Live countdown grid for the current ZZZ version.
 *
 * Renders one timer per milestone (launch, Phase I end, Phase II end, version
 * end) plus a status strip that follows the official schedule:
 *
 *   pre-download open -> pre-download closed -> maintenance -> live -> ended
 *
 * Two rules drive the implementation:
 *
 * 1. Without JavaScript the page still shows every target moment as a
 *    formatted date, so crawlers and readers with JS disabled get the facts.
 * 2. The target moment is always an absolute UTC instant. The visitor's local
 *    clock is derived from it in the browser, never by adding a fixed offset,
 *    so daylight saving time cannot shift the answer.
 */
import { milestones, countdownTargets, SITE, sourceById } from '~/data/zzz';
import CountdownScript from '~/components/common/CountdownScript.astro';

interface Props {
  id?: string;
  /** Show the status strip above the timers. */
  showStatus?: boolean;
  class?: string;
}

const { id = 'countdown', showStatus = true, class: className = '' } = Astro.props;

const targets = countdownTargets
  .map((key) => milestones.find((m) => m.id === key))
  .filter((m): m is NonNullable<typeof m> => Boolean(m));

const fmtUtc8 = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Asia/Shanghai',
  }).format(new Date(iso)) + ' (UTC+8)';

const fmtServer = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Asia/Shanghai',
  }).format(new Date(iso)) + ' (server time)';

// Server-side fallback: the server cannot know the visitor's zone, so it
// prints the UTC+8 moment. The script replaces it with the browser's zone.
const fmtLocal = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Asia/Shanghai',
  }).format(new Date(iso)) + ' (UTC+8)';

const byId = (key: string) => milestones.find((m) => m.id === key)!;
const predownloadStart = byId('predownload-start');
const predownloadEnd = byId('predownload-end');
const maintenance = byId('maintenance-start');
---

<div class={className} id={id}>
  {
    showStatus && (
      <div
        class="mb-6 rounded-2xl border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 sm:p-5"
        data-zzz-status
        data-predownload-start={predownloadStart.at}
        data-predownload-end={predownloadEnd.at}
        data-maintenance-start={maintenance.at}
        data-launch={byId('launch').at}
        data-version-end={byId('version-end').at}
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-3 w-3 shrink-0 rounded-full bg-amber-400" data-status-dot aria-hidden="true" />
            <p class="text-lg font-semibold text-heading" data-status-title>
              Checking the official schedule&hellip;
            </p>
          </div>
          <CountdownScript />
          <p class="text-sm text-muted" data-status-detail />
        </div>
        <p class="mt-2 text-sm text-muted">
          Status follows the official schedule
          {' · '}
          <a
            class="font-medium text-primary underline underline-offset-2 dark:text-blue-300"
            href={sourceById('E01')!.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Pre-Download &amp; Update Notice
          </a>
          {' · last checked '}
          {SITE.lastChecked}
        </p>
      </div>
    )
  }

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      targets.map((m) => (
        <div
          class="flex flex-col rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900"
          data-zzz-timer
          data-target={m.at}
          data-label={m.label}
          data-estimated={m.estimated ? 'true' : 'false'}
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-muted">{m.label}</p>

          <div class="mt-3 flex items-baseline gap-1 font-heading text-4xl font-bold tabular-nums text-heading">
            <span data-unit="days">--</span>
            <span class="text-lg text-muted">d</span>
            <span data-unit="hours">--</span>
            <span class="text-lg text-muted">h</span>
            <span data-unit="minutes">--</span>
            <span class="text-lg text-muted">m</span>
            <span data-unit="seconds">--</span>
            <span class="text-lg text-muted">s</span>
          </div>

          <p class="mt-3 text-sm font-medium text-heading" data-timer-state>
            Loading&hellip;
          </p>

          <p class="mt-1 text-xs text-muted">
            {m.clock === 'server' ? fmtServer(m.at) : fmtUtc8(m.at)}
            <span class="block" data-local-time>
              {fmtLocal(m.at)}
            </span>
          </p>

          {m.estimated && (
            <p class="mt-2 rounded-lg bg-amber-50 px-2 py-1 text-xs text-amber-800 dark:bg-amber-950/40 dark:text-amber-200">
              Estimated from the official maintenance window, not a published go-live time.
            </p>
          )}

          <p class="mt-2 text-xs text-muted">{m.note}</p>
        </div>
      ))
    }
  </div>
</div>

---
import Layout from '~/layouts/PageLayout.astro';

import Note from '~/components/widgets/Note.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import SectionArt from '~/components/widgets/SectionArt.astro';
import KeyDates from '~/components/widgets/KeyDates.astro';
import Image from '~/components/common/Image.astro';

import { newContent, sourceById, SITE } from '~/data/zzz';

import journeyArt from '~/assets/images/official/mech.jpg';

const metadata = {
  title: 'What\'s New in ZZZ 3.3 "Journey to the Sky": Phoenix, Severian and Mech Combat',
  description:
    'A structured guide to Zenless Zone Zero Version 3.3 — new S-Rank Agents Phoenix and Severian, new W-Engines, mech combat, new events and areas, store additions and login rewards, sourced from the official update announcement.',
  ignoreTitleTemplate: true,
};

const updateNotice = sourceById('E02')!;

/** Colour cue per attribute, used as a chip on the agent cards. */
const attributeTone: Record<string, string> = {
  'Fire - Anomaly': 'from-orange-500 to-rose-500',
  'Wind - Attack': 'from-teal-400 to-cyan-500',
  'Wind - Anomaly': 'from-sky-400 to-indigo-500',
  Anomaly: 'from-violet-500 to-purple-600',
  Attack: 'from-amber-400 to-orange-500',
  Armorer: 'from-zinc-400 to-slate-600',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6">
    <p class="text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">Zenless Zone Zero 3.3</p>
    <h1 class="mt-2 max-w-4xl text-4xl font-bold leading-tight tracking-tighter text-heading md:text-5xl">
      What's new in Version 3.3
    </h1>
    <p class="mt-4 max-w-3xl text-xl text-muted">
      Two limited S-Rank Agents, three W-Engines, controllable mech combat, two new areas and a full event slate —
      written out from the official update announcement.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-10 sm:px-6">
    <SectionArt
      src={journeyArt.src}
      alt="Official 3.3 art: the W-Engine showcase from the Special Program Intel Report"
      shape="wide"
      caption="Official HoYoverse art from the 3.3 Special Program Intel Report."
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="agents">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">New S-Rank Agents</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        newContent.agents.map((a) => (
          <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-slate-700 dark:bg-slate-900">
            <Image
              src={a.image}
              alt={`Official key art for ${a.title}`}
              width={880}
              height={495}
              widths={[440, 880]}
              sizes="(max-width: 768px) 100vw, 560px"
              layout="constrained"
              format="webp"
              class="aspect-[16/9] w-full object-cover"
              loading="lazy"
            />
            <div class:list={['h-2 bg-gradient-to-r', attributeTone[a.attribute] ?? 'from-cyan-500 to-blue-600']} />
            <div class="p-6">
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class:list={[
                    'rounded-full px-2.5 py-1 text-xs font-semibold text-white',
                    'bg-gradient-to-r',
                    attributeTone[a.attribute] ?? 'from-cyan-500 to-blue-600',
                  ]}
                >
                  {a.attribute}
                </span>
                <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700 dark:bg-slate-800 dark:text-slate-200">
                  {a.channel}
                </span>
              </div>
              <p class="mt-3 text-2xl font-bold text-heading">{a.title}</p>
              <p class="mt-2 text-muted">{a.blurb}</p>
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-3 text-sm text-muted">
      Both are limited Agents, obtained through Signal Search channels. Source:
      <a
        class="font-medium text-primary underline underline-offset-2 dark:text-blue-300"
        href={updateNotice.url}
        target="_blank"
        rel="noopener noreferrer">{updateNotice.id} · {updateNotice.title}</a
      >
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="w-engines">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">New W-Engines</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        newContent.wEngines.map((w) => (
          <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-slate-700 dark:bg-slate-900">
            <Image
              src={w.image}
              alt={`Official key art for the ${w.name} W-Engine`}
              width={560}
              height={315}
              widths={[280, 560]}
              sizes="(max-width: 640px) 100vw, 320px"
              layout="constrained"
              format="webp"
              class="aspect-[16/9] w-full object-cover"
              loading="lazy"
            />
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted">{w.phase}</p>
              <p class="mt-2 text-lg font-bold text-heading">{w.name}</p>
              <p class="mt-1 text-sm text-muted">{w.attribute}</p>
            </div>
          </div>
        ))
      }
    </div>

    <h3 class="mt-10 text-xl font-bold text-heading">New outfits</h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        newContent.outfits.map((o) => (
          <li class="rounded-full border border-gray-200 bg-white px-3 py-1 text-sm text-muted dark:border-slate-700 dark:bg-slate-900">
            {o.name} · {o.owner}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="features">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">New events and gameplay</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        newContent.features.map((f) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-lg font-bold text-heading">{f.title}</p>
            <p class="mt-2 text-sm text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">New areas</p>
        <ul class="mt-2 space-y-1 text-sm text-muted">
          {newContent.areas.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">Game modes</p>
        <ul class="mt-2 space-y-1 text-sm text-muted">
          {newContent.gameModes.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">Story</p>
        <p class="mt-2 text-sm text-muted">{newContent.story}</p>
      </div>
    </div>

    <h3 class="mt-10 text-xl font-bold text-heading">Event list</h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        newContent.events.map((e) => (
          <li class="rounded-full border border-gray-200 bg-white px-3 py-1 text-sm text-muted dark:border-slate-700 dark:bg-slate-900">
            {e}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="rewards">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">Rewards and compensation</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        newContent.rewards.map((r) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{r.label}</p>
            <p class="mt-2 font-heading text-2xl font-bold text-heading">{r.value}</p>
            <p class="mt-1 text-sm text-muted">{r.when}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="store">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">Store additions</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[40rem] text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 dark:border-slate-700">
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">Item</th>
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">Price</th>
            <th scope="col" class="py-3 font-semibold text-heading">Availability</th>
          </tr>
        </thead>
        <tbody>
          {
            newContent.store.map((s) => (
              <tr class="border-b border-gray-100 dark:border-slate-800">
                <th scope="row" class="py-3 pr-4 align-top font-medium text-heading">
                  {s.item}
                </th>
                <td class="py-3 pr-4 align-top text-muted">{s.price}</td>
                <td class="py-3 align-top text-muted">{s.when}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="mt-6">
      <Note
        variant="info"
        title="Bundle and single-item discounts do not stack."
        description="The official store notice states that outfit bundle deals and individual item discounts are separate promotions and cannot be combined."
      />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="dates">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">The dates behind this update</h2>
    <p class="mt-3 max-w-3xl text-lg text-muted">
      The content above is the “what”. The “when” lives on three pages, each with a live timer.
    </p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        [
          {
            title: 'Countdown',
            description: 'Four timers: launch, Phase I end, Phase II end, version end.',
            href: '/',
            icon: 'tabler:clock-hour-4',
          },
          {
            title: 'Banner phases',
            description: 'Phoenix and Velina close on November 11; Severian takes over.',
            href: '/banners',
            icon: 'tabler:repeat',
          },
          {
            title: 'Release time',
            description: 'The same moments in 14 time zones, with the right offsets.',
            href: '/release-time',
            icon: 'tabler:world',
          },
        ].map((c) => (
          <a
            href={c.href}
            class="group rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-primary/50 hover:shadow-lg dark:border-slate-700 dark:bg-slate-900"
          >
            <p class="text-lg font-bold text-heading">{c.title}</p>
            <p class="mt-2 text-sm text-muted">{c.description}</p>
            <p class="mt-3 text-xs text-muted group-hover:text-primary dark:group-hover:text-blue-300">Open →</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6">
    <KeyDates
      title="Key deadlines"
      only={['phase1-end', 'phase2-end', 'version-end', 'fix-compensation-end', 'store-sale-end']}
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6">
    <FAQs
      title="3.3 content FAQ"
      tagline="FAQ"
      items={[
        {
          title: 'Are Phoenix and Severian limited Agents?',
          description:
            'Yes. Both are limited S-Rank Agents from Signal Search channels, and the official Phase I notice states that they do not appear in the Star-Studded Cast Stable Channel.',
        },
        {
          title: 'Which banner do Phoenix and Severian run in?',
          description:
            'Phoenix runs in the "Into the Flames of Life" Exclusive channel in Phase I, Severian in "Answers in the Wind" in Phase II.',
        },
        {
          title: 'When do the new outfits leave the shop?',
          description:
            'The "Empty Daydreams" bundle and the discounted Phoenix outfits are available until 2026/12/02 05:59 (UTC+8). After the discount, the individual outfits cost Monochrome x1,680.',
        },
      ]}
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-4 mt-10 sm:px-6">
    <Note
      variant="info"
      title="Every line on this page comes from the official update announcement."
      description={`Source: ${updateNotice.id} · ${updateNotice.title} — ${SITE.lastChecked}. ${SITE.disclaimer}`}
    />
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Open the live countdown',
        href: '/',
        icon: 'tabler:clock-hour-4',
      },
      { text: 'See the banner schedule', href: '/banners' },
    ]}
  >
    <Fragment slot="title">
      The update is live.<br class="block sm:hidden" />
      <span class="sm:whitespace-nowrap">The clock is not done</span>
    </Fragment>

    <Fragment slot="subtitle"> Phase I ends November 11. Version 3.3 ends December 2. </Fragment>
  </CallToAction>
</Layout>

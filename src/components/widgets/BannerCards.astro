---
/**
 * Banner cards for a version phase. Each card carries its own live timer, so
 * the page answers "how long do I have left to pull" without a page reload.
 */
import { banners, sourceById } from '~/data/zzz';
import CountdownScript from '~/components/common/CountdownScript.astro';

interface Props {
  phase?: 'Phase I' | 'Phase II';
  id?: string;
}

const { phase, id } = Astro.props;

const list = phase ? banners.filter((b) => b.phase === phase) : banners;
---

<div class="grid gap-4 md:grid-cols-2" id={id}>
  {
    list.map((b) => (
      <div
        class:list={[
          'flex flex-col rounded-2xl border p-5 dark:bg-slate-900',
          b.highlight
            ? 'border-primary/40 bg-primary/5 dark:border-blue-700/60'
            : 'border-gray-200 bg-white dark:border-slate-700',
        ]}
        data-zzz-timer
        data-target={b.endIso}
        data-label={`${b.name} banner ends`}
        data-estimated="false"
      >
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">
              {b.phase} · {b.kind}
            </p>
            <p class="mt-1 text-xl font-bold text-heading">{b.name}</p>
            <p class="text-sm text-muted">{b.attribute || 'Attribute not published in the notice linked below'}</p>
          </div>
          <CountdownScript />
          <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700 dark:bg-slate-800 dark:text-slate-200">
            {b.channel}
          </span>
        </div>

        <div class="mt-4 flex items-baseline gap-1 font-heading text-3xl font-bold tabular-nums text-heading">
          <span data-unit="days">--</span>
          <span class="text-base text-muted">d</span>
          <span data-unit="hours">--</span>
          <span class="text-base text-muted">h</span>
          <span data-unit="minutes">--</span>
          <span class="text-base text-muted">m</span>
          <span data-unit="seconds">--</span>
          <span class="text-base text-muted">s</span>
        </div>

        <p class="mt-2 text-sm font-medium text-heading" data-timer-state>
          Loading&hellip;
        </p>

        <p class="mt-1 text-xs text-muted">
          {b.start} → {b.end}
        </p>

        <p class="mt-2 text-xs text-muted">
          Source:{' '}
          <a
            class="font-medium text-primary underline underline-offset-2 dark:text-blue-300"
            href={sourceById(b.sourceId)!.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {b.sourceId} · {sourceById(b.sourceId)!.title}
          </a>
        </p>
      </div>
    ))
  }
</div>

---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import VersionCountdown from '~/components/widgets/VersionCountdown.astro';
import PhaseTimeline from '~/components/widgets/PhaseTimeline.astro';
import SectionArt from '~/components/widgets/SectionArt.astro';
import LocalTime from '~/components/widgets/LocalTime.astro';

import StructuredData from '~/components/common/StructuredData.astro';

import { SITE, I18N } from 'astrowind:config';
import { banners, faqs, preDownload, newContent } from '~/data/zzz';

import heroKeyart from '~/assets/images/hero-keyart.jpg';
import phaseArt from '~/assets/images/phase-art.jpg';

const metadata = {
  title: 'ZZZ 3.3 Countdown: Live Timer, Release Time & Banners (Oct 21, 2026)',
  description:
    'Live countdown to Zenless Zone Zero 3.3 "Journey to the Sky" — release time in your timezone, Phase 1 and Phase 2 banner timers, and the date Version 3.3 ends. Every date checked against the official HoYoverse announcement.',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
  },
  ...banners.map((b) => ({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: `${b.channel} - ${b.name} Signal Search (Zenless Zone Zero ${b.phase})`,
    startDate: b.start,
    endDate: b.endIso,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
    location: { '@type': 'VirtualLocation', url: `${SITE?.site}/banners/` },
  })),
];

const phase1 = banners.filter((b) => b.phase === 'Phase I');
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    tagline="Zenless Zone Zero · Version 3.3"
    badge="Live timer"
    actions={[
      {
        variant: 'primary',
        text: 'Release time in your zone',
        href: '/release-time',
        icon: 'tabler:clock-hour-4',
      },
      { text: 'See the 3.3 banners', href: '/banners' },
    ]}
  >
    <Fragment slot="title">
      ZZZ 3.3 Countdown:<br class="hidden sm:inline" />
      <span class="text-accent dark:text-white">"Journey to the Sky"</span>
    </Fragment>

    <Fragment slot="subtitle">
      Version 3.3 went live on <strong>October 21, 2026</strong>. Below is the countdown to the
      <strong>Phase I switch</strong>, the <strong>Phase II switch</strong> and the <strong>end of 3.3</strong> — every date
      taken from the official announcement.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0">
        <img
          src={heroKeyart.src}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover opacity-45 dark:opacity-60"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950/85 via-slate-950/70 to-slate-950/90"></div>
      </div>
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-7xl px-4 sm:px-6">
    <VersionCountdown />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-10 sm:px-6">
    <PhaseTimeline />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-10 sm:px-6">
    <Note
      variant="info"
      title="Every date here comes from an official announcement."
      description="The go-live moment is an estimate: maintenance starts 2026/10/21 06:00 (UTC+8) and HoYoverse says it “will take five hours”. Everything else is printed in the notices, and each row links to the post it comes from."
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="your-time">
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">In your time zone</p>
        <p class="mt-2 text-xl font-bold text-heading">
          <LocalTime iso="2026-10-21T11:00:00+08:00" />
        </p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">On the server clock</p>
        <p class="mt-2 text-xl font-bold text-heading">Oct 21 · 11:00 (UTC+8)</p>
        <p class="mt-1 text-sm text-muted">The same moment as Oct 20, 23:00 EDT.</p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">Maintenance window</p>
        <p class="mt-2 text-xl font-bold text-heading">06:00 → ~11:00</p>
        <p class="mt-1 text-sm text-muted">Servers are closed while the update installs.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6" id="banners">
    <SectionArt
      src={phaseArt.src}
      alt="Two glowing ring portals on a dark horizon, standing for the two banner phases of Version 3.3"
      eyebrow="Phase I → Phase II"
      heading="Two banner phases, eight channels"
      caption="Original artwork for this site."
    />

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        phase1.map((b) => (
          <a
            href="/banners"
            class="group rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-primary/50 hover:shadow-lg dark:border-slate-700 dark:bg-slate-900"
          >
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{b.kind}</p>
            <p class="mt-1 text-lg font-bold text-heading">{b.name}</p>
            <p class="text-sm text-muted">{b.attribute || '—'}</p>
            <p class="mt-3 text-xs text-muted group-hover:text-primary dark:group-hover:text-blue-300">
              ends {b.end} →
            </p>
          </a>
        ))
      }
    </div>

    <p class="mt-4 text-muted">
      All four Phase I channels close at 2026/11/11 11:59 (server time), when Phase II opens with Severian and the Phase
      II reruns. <a class="font-medium text-primary underline underline-offset-2 dark:text-blue-300" href="/banners"
        >See every channel with its own timer</a
      >.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6" id="pre-download">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">Pre-download sizes</h2>
    <p class="mt-3 max-w-3xl text-lg text-muted">
      The 3.3 pre-download ran from {preDownload.window}. PC players could keep playing; on mobile the official notice
      says the game cannot be played during the download.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        preDownload.platforms.map((p) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-sm font-semibold text-heading">{p.platform}</p>
            <p class="mt-2 font-heading text-3xl font-bold text-heading">{p.size}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-4 text-muted">
      The Polychrome x300 update compensation needed Inter-Knot Lv. 4 before 2026/10/21 06:00 (UTC+8).
      <a class="font-medium text-primary underline underline-offset-2 dark:text-blue-300" href="/pre-download"
        >Pre-download details and compensation</a
      >.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6" id="whats-new">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">What's new in 3.3</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        newContent.agents.map((a) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{a.attribute}</p>
            <p class="mt-2 text-2xl font-bold text-heading">{a.title}</p>
            <p class="mt-1 text-sm font-medium text-primary dark:text-blue-300">{a.channel}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-muted">
      Plus mech combat, two new restricted areas, a full event slate and store additions.
      <a class="font-medium text-primary underline underline-offset-2 dark:text-blue-300" href="/whats-new"
        >The full 3.3 content breakdown</a
      >.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6" id="next">
    <Features
      tagline="Next steps"
      title="What are you trying to do?"
      items={[
        {
          title: 'Convert the release time',
          description: 'Every 3.3 moment in 14 time zones, with the offsets that actually apply.',
          icon: 'tabler:world',
        },
        {
          title: 'Check the banner schedule',
          description: 'All eight channels with a live timer on each one.',
          icon: 'tabler:repeat',
        },
        {
          title: 'Prepare the pre-download',
          description: 'Sizes, the window, and who qualifies for the compensation.',
          icon: 'tabler:download',
        },
        {
          title: 'Read what changed',
          description: 'Agents, W-Engines, mech combat, events and rewards.',
          icon: 'tabler:list-details',
        },
      ]}
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6" id="faqs">
    <FAQs
      title="ZZZ 3.3 countdown FAQ"
      subtitle="The questions that come up on every version launch."
      tagline="FAQ"
      schema
      items={faqs.home.slice(0, 6)}
    />
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Check the 3.3 banner schedule',
        href: '/banners',
        icon: 'tabler:repeat',
      },
      { text: 'Release time in my zone', href: '/release-time' },
    ]}
  >
    <Fragment slot="title">
      Every 3.3 date,<br class="block sm:hidden" />
      <span class="sm:whitespace-nowrap">one source of truth</span>
    </Fragment>

    <Fragment slot="subtitle">
      Phase I ends 2026/11/11 11:59 (server time). Version 3.3 ends 2026/12/02 06:00 (UTC+8).
    </Fragment>
  </CallToAction>
</Layout>

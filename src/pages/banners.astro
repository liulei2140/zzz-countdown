---
import Layout from '~/layouts/PageLayout.astro';

import Note from '~/components/widgets/Note.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SectionArt from '~/components/widgets/SectionArt.astro';
import PhaseTimeline from '~/components/widgets/PhaseTimeline.astro';

import BannerCards from '~/components/widgets/BannerCards.astro';
import KeyDates from '~/components/widgets/KeyDates.astro';

import StructuredData from '~/components/common/StructuredData.astro';

import { banners, faqs, sourceById } from '~/data/zzz';

import phaseArt from '~/assets/images/phase-art.jpg';

const metadata = {
  title: 'ZZZ 3.3 Banners: Phase 1 and Phase 2 Schedule with Live Countdowns',
  description:
    'Every Zenless Zone Zero 3.3 Signal Search banner with a live timer — Phoenix and Velina in Phase 1, Severian in Phase 2, and the exact phase end times in server time.',
  ignoreTitleTemplate: true,
};

const structuredData = banners.map((b) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${b.channel} - ${b.name} Signal Search (Zenless Zone Zero ${b.phase})`,
  startDate: b.start,
  endDate: b.endIso,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
}));

const rule = sourceById('E03')!;
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6">
    <p class="text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">Zenless Zone Zero 3.3</p>
    <h1 class="mt-2 max-w-4xl text-4xl font-bold leading-tight tracking-tighter text-heading md:text-5xl">
      ZZZ 3.3 banners and phase timers
    </h1>
    <p class="mt-4 max-w-3xl text-xl text-muted">
      Two phases, eight channels, and a live timer on every card. Phase I closes
      <strong class="text-heading">2026/11/11 11:59 (server time)</strong>; Version 3.3 ends
      <strong class="text-heading">2026/12/02 06:00 (UTC+8)</strong>.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-10 sm:px-6">
    <SectionArt
      src={phaseArt.src}
      alt="Two glowing ring portals on a dark horizon, standing for the two banner phases of Version 3.3"
      eyebrow="Phase I → Phase II"
      heading="Two phases, eight channels"
      caption="Original artwork for this site."
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-10 sm:px-6">
    <PhaseTimeline />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6" id="phase-1">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">Phase I banners</h2>
    <p class="mt-3 max-w-3xl text-lg text-muted">
      Opened with the version on 2026/10/21 06:00 (UTC+8). Two Exclusive Agent channels, two W-Engine channels, all four
      closing together.
    </p>
    <div class="mt-6">
      <BannerCards phase="Phase I" />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6" id="phase-2">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">Phase II banners</h2>
    <p class="mt-3 max-w-3xl text-lg text-muted">
      Severian and a Norma rerun, plus two new W-Engine channels. Lineup from the 3.3 Intel Report.
    </p>
    <div class="mt-6">
      <BannerCards phase="Phase II" />
    </div>

    <div class="mt-6">
      <Note
        variant="warning"
        title="The Phase II end time is still an estimate."
        description="The official Phase I notice confirms the November 11 switch. The Phase II end time comes from the Intel Report and is confirmed when HoYoverse publishes the Phase II notice."
      />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6" id="rules">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">The guaranteed-signal rule</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-sm font-bold text-heading">Cumulative across Exclusive Channels</p>
        <p class="mt-2 text-sm text-muted">
          The search count for guaranteed signals is cumulative across all Exclusive Channels, and independent of other
          channel types.
        </p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-sm font-bold text-heading">Limited units skip the stable channel</p>
        <p class="mt-2 text-sm text-muted">
          The limited S-Rank Agents and W-Engines in the Phase I channels do not appear in the Star-Studded Cast Stable
          Channel.
        </p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-sm font-bold text-heading">Two Agents, two W-Engines</p>
        <p class="mt-2 text-sm text-muted">
          Phoenix and Velina run as Exclusive channels, joined by the Plume of Rebirth and Joyau Dore W-Engine channels.
        </p>
      </div>
    </div>
    <p class="mt-4 text-sm text-muted">
      Source:{' '}
      <a
        class="font-medium text-primary underline underline-offset-2 dark:text-blue-300"
        href={rule.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {rule.id} · {rule.title}
      </a>
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6">
    <KeyDates
      title="Banner and version deadlines"
      only={['phase1-end', 'phase2-end', 'version-end', 'fix-compensation-end', 'store-sale-end']}
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-16 sm:px-6">
    <FAQs
      title="ZZZ banner timer FAQ"
      subtitle="The questions the 3.3 banner schedule raises every version."
      tagline="FAQ"
      items={faqs.banners}
    />
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'What is new in 3.3',
        href: '/whats-new',
        icon: 'tabler:list-details',
      },
      { text: 'Release time in my zone', href: '/release-time' },
    ]}
  >
    <Fragment slot="title">
      Know the schedule,<br class="block sm:hidden" />
      <span class="sm:whitespace-nowrap">then decide</span>
    </Fragment>

    <Fragment slot="subtitle">
      Phoenix and Velina close on November 11. Severian and the Phase II reruns take over the same moment.
    </Fragment>
  </CallToAction>
</Layout>

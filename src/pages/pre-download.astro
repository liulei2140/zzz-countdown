---
import Layout from '~/layouts/PageLayout.astro';

import Note from '~/components/widgets/Note.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';

import KeyDates from '~/components/widgets/KeyDates.astro';

import { preDownload, faqs, sourceById } from '~/data/zzz';

const metadata = {
  title: 'ZZZ 3.3 Pre-Download Size for PC, Mobile, PS5 and Xbox',
  description:
    'Official Zenless Zone Zero 3.3 pre-download sizes, the download window, what each platform can do while downloading, and who qualifies for the Polychrome x300 update compensation.',
  ignoreTitleTemplate: true,
};

const notice = sourceById('E01')!;
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6">
    <p class="text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">Zenless Zone Zero 3.3</p>
    <h1 class="mt-2 max-w-4xl text-4xl font-bold leading-tight tracking-tighter text-heading md:text-5xl">
      ZZZ 3.3 pre-download: sizes, deadlines and compensation
    </h1>
    <p class="mt-4 max-w-3xl text-xl text-muted">
      The 3.3 pre-download ran from <strong class="text-heading">{preDownload.window}</strong>. The numbers below are
      printed in the official notice, and so are the two things that usually get missed: mobile players could not play
      while the download ran, and the compensation needed Inter-Knot Lv. 4 before maintenance started.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        preDownload.platforms.map((p) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-sm font-semibold text-heading">{p.platform}</p>
            <p class="mt-2 font-heading text-3xl font-bold text-heading">{p.size}</p>
            <p class="mt-2 text-sm text-muted">{p.detail}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-4 text-sm text-muted">
      Source:{' '}
      <a
        class="font-medium text-primary underline underline-offset-2 dark:text-blue-300"
        href={notice.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {notice.id} · {notice.title}
      </a>
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-12 sm:px-6">
    <Note
      variant="warning"
      title="The 3.3 pre-download window has closed."
      description="It ended at 2026/10/21 05:50 (UTC+8), a few minutes before maintenance started. The sizes and rules below are kept because every version ships the same pattern, and the last section explains what to do differently next time."
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="sizes">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">Pre-download window and size by platform</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[40rem] text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 dark:border-slate-700">
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">Platform</th>
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">Pre-download size</th>
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">How to start it</th>
            <th scope="col" class="py-3 font-semibold text-heading">Can you play meanwhile?</th>
          </tr>
        </thead>
        <tbody>
          {
            preDownload.platforms.map((p) => (
              <tr class="border-b border-gray-100 dark:border-slate-800">
                <th scope="row" class="py-3 pr-4 align-top font-medium text-heading">
                  {p.platform}
                </th>
                <td class="py-3 pr-4 align-top text-muted">{p.size}</td>
                <td class="py-3 pr-4 align-top text-muted">{p.detail}</td>
                <td class="py-3 align-top text-muted">{p.platform.startsWith('Mobile') ? 'No' : 'Yes'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-muted">
      The official notice adds: make sure the device has sufficient space, use Wi-Fi, and remember that installed voice
      packs change the space the download needs.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="while-downloading">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">
      Can you play while the pre-download runs?
    </h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        preDownload.notes.map((n) => (
          <div
            class:list={[
              'rounded-2xl border p-5 dark:bg-slate-900',
              n.tone === 'warn'
                ? 'border-amber-200 bg-amber-50 dark:border-amber-800/60 dark:bg-amber-950/30'
                : 'border-gray-200 bg-white dark:border-slate-700',
            ]}
          >
            <p class="text-sm font-bold text-heading">{n.label}</p>
            <p class="mt-2 text-muted">{n.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="how-to">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">How to pre-download on each platform</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        preDownload.steps.map((s) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-sm font-bold uppercase tracking-wider text-muted">{s.platform}</p>
            <ol class="mt-3 list-decimal space-y-2 pl-5 text-muted">
              {s.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="compensation">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">
      Polychrome x300 server update compensation
    </h2>
    <div class="mt-4 max-w-3xl space-y-4 text-lg text-muted">
      <p>
        The server update compensation is <strong class="text-heading">Polychrome x300</strong>, and it has three
        conditions attached to it:
      </p>
      <ul class="list-disc space-y-2 pl-5">
        <li>
          <strong class="text-heading">Eligibility:</strong> you had to reach Inter-Knot Lv. 4 before 2026/10/21 06:00 (UTC+8).
          Proxies below that level did not qualify.
        </li>
        <li>
          <strong class="text-heading">Delivery:</strong> it is issued by in-game mail after the update completes.
        </li>
        <li>
          <strong class="text-heading">Deadline:</strong> the mail has to be claimed before the end of Version 3.3, and the
          mail itself expires after 30 days.
        </li>
      </ul>
      <p>
        A second, separate payment of Polychrome x300 covers the issue fixes. It has to be claimed by logging in before
        2026/11/20 23:59 (UTC+8).
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="next-version">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">The next version: what to do differently</h2>
    <Features
      tagline="Reusable checklist"
      title="The 3.3 pre-download routine, ready for the next one"
      subtitle="Every ZZZ version follows the same three-step pattern, and the notice usually arrives two days before maintenance."
      items={[
        {
          title: 'Watch for the notice, not the trailer',
          description:
            'The Pre-Download & Update Notice carries the sizes, the window and the compensation rules. It is published separately from the trailer and the Special Program.',
        },
        {
          title: 'Start the download early',
          description:
            'The window closes ten minutes before maintenance begins. On console the download may start on its own if storage is reserved, but it does not start before the notice is live.',
        },
        {
          title: 'Check the compensation conditions early',
          description:
            'Inter-Knot Lv. 4 before the maintenance start is the eligibility line. Check it the day the notice appears, not on update day.',
        },
        {
          title: 'Plan the mobile case separately',
          description:
            'Mobile is the only platform that cannot play during the pre-download, so the download has to finish before you plan to play.',
        },
      ]}
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6">
    <KeyDates
      title="Pre-download and compensation deadlines"
      only={['predownload-start', 'predownload-end', 'maintenance-start', 'fix-compensation-end']}
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6">
    <FAQs
      title="Pre-download FAQ"
      subtitle="The questions the 3.3 download window raised."
      tagline="FAQ"
      items={faqs.preDownload}
    />
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Open the live countdown',
        href: '/',
        icon: 'tabler:clock-hour-4',
      },
      { text: 'See all 3.3 deadlines', href: '/#your-time' },
    ]}
  >
    <Fragment slot="title">
      The next window<br class="block sm:hidden" />
      <span class="sm:whitespace-nowrap">starts sooner</span>
    </Fragment>

    <Fragment slot="subtitle">
      Every version ships with the same notice format. This page keeps the pattern, the numbers and the conditions.
    </Fragment>
  </CallToAction>
</Layout>

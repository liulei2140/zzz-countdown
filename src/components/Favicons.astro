---
import favIconSvg from '~/assets/favicons/favicon.svg';
import icon32 from '~/assets/favicons/icon-32.png';
import icon192 from '~/assets/favicons/icon-192.png';
import icon512 from '~/assets/favicons/icon-512.png';
import appleTouchIcon from '~/assets/favicons/apple-touch-icon.png';
---

<link rel="icon" type="image/svg+xml" href={favIconSvg.src} />
<link rel="icon" type="image/png" sizes="32x32" href={icon32.src} />
<link rel="icon" type="image/png" sizes="192x192" href={icon192.src} />
<link rel="icon" type="image/png" sizes="512x512" href={icon512.src} />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
<meta name="theme-color" content="#0b0d1c" />

# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# pnpm-specific files: pnpm is supported for local use (see .pnpmrc), but
# package-lock.json is the tracked lockfile and npm is what CI, Docker and
# the deploy targets run. Committing these would let the two trees diverge.
pnpm-lock.yaml
pnpm-workspace.yaml

.astro
# wrangler local state
.wrangler/

# generated favicon raster files (scripts/build-favicons.mjs rebuilds them
# from src/assets/favicons/favicon.svg on every build)
src/assets/favicons/icon-32.png
src/assets/favicons/icon-192.png
src/assets/favicons/icon-512.png
src/assets/favicons/apple-touch-icon.png
public/favicon.ico

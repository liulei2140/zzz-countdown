---
/**
 * Proportional timeline of the version cycle.
 *
 * The bar is drawn to scale: the length of each segment is the real duration
 * of that part of the version, so a reader sees at a glance how much of the
 * cycle is left. A marker shows where "now" sits and moves as the page stays
 * open.
 */
import { milestones } from '~/data/zzz';

interface Props {
  id?: string;
  class?: string;
}

const { id = 'phase-timeline', class: className = '' } = Astro.props;

const at = (key: string) => milestones.find((m) => m.id === key)!;

const segments = [
  {
    key: 'phase1',
    label: 'Phase I',
    sub: 'Phoenix · Velina · Plume of Rebirth · Joyau Dore',
    from: at('launch').at,
    to: at('phase1-end').at,
    tone: 'from-cyan-500 to-blue-600',
  },
  {
    key: 'phase2',
    label: 'Phase II',
    sub: 'Severian · Norma · Incarcerating Grip · Chief Sidekick',
    from: at('phase1-end').at,
    to: at('phase2-end').at,
    tone: 'from-violet-500 to-purple-700',
  },
  {
    key: 'end',
    label: 'Version ends',
    sub: '2026/12/02 06:00 (UTC+8)',
    from: at('phase2-end').at,
    to: at('version-end').at,
    tone: 'from-slate-400 to-slate-600',
  },
];

const start = new Date(at('launch').at).getTime();
const end = new Date(at('version-end').at).getTime();
const total = end - start;

const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'Asia/Shanghai' }).format(new Date(iso));
---

<div class={className} id={id}>
  <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900 sm:p-6">
    <div class="flex items-center justify-between gap-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted">Version 3.3 cycle</p>
      <p class="text-xs text-muted" data-timeline-remaining>42 days in total</p>
    </div>

    <div class="relative mt-6">
      <!-- the track -->
      <div class="flex h-3 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-slate-800">
        {
          segments.map((s) => (
            <div
              class:list={['h-full bg-gradient-to-r', s.tone]}
              style={`width: ${((new Date(s.to).getTime() - new Date(s.from).getTime()) / total) * 100}%`}
              title={`${s.label}: ${fmt(s.from)} → ${fmt(s.to)}`}
            />
          ))
        }
      </div>

      <!-- the "now" marker -->
      <div
        class="pointer-events-none absolute -top-1.5 h-6 w-6 -translate-x-1/2 rounded-full border-2 border-white bg-white shadow-lg dark:border-slate-900"
        data-timeline-marker
        style="left: 0%"
        aria-hidden="true"
      >
        <span class="absolute inset-1 rounded-full bg-gradient-to-br from-cyan-400 to-violet-500"></span>
      </div>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        segments.map((s) => (
          <div>
            <div class="flex items-center gap-2">
              <span class:list={['h-2.5 w-2.5 rounded-full bg-gradient-to-r', s.tone]} />
              <p class="text-sm font-bold text-heading">{s.label}</p>
            </div>
            <p class="mt-1 text-sm font-medium text-heading">
              {fmt(s.from)} → {fmt(s.to)}
            </p>
            <p class="mt-0.5 text-xs text-muted">{s.sub}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  /**
   * Positions the marker at the current point of the version cycle and keeps
   * the remaining-days label in sync.
   */
  const move = () => {
    const start = new Date('2026-10-21T11:00:00+08:00').getTime();
    const end = new Date('2026-12-02T06:00:00+08:00').getTime();
    const now = Date.now();
    const ratio = Math.min(1, Math.max(0, (now - start) / (end - start)));

    document.querySelectorAll<HTMLElement>('[data-timeline-marker]').forEach((el) => {
      el.style.left = `${ratio * 100}%`;
      el.style.opacity = now < start ? '0.4' : '1';
    });

    document.querySelectorAll<HTMLElement>('[data-timeline-remaining]').forEach((el) => {
      const left = end - now;
      if (left <= 0) {
        el.textContent = 'Version 3.3 has ended';
        return;
      }
      const days = Math.floor(left / 86400000);
      const hours = Math.floor((left % 86400000) / 3600000);
      el.textContent = days > 0 ? `${days}d ${hours}h left in the cycle` : `${hours}h left in the cycle`;
    });
  };

  move();
  document.addEventListener('astro:page-load', move);
  window.setInterval(move, 60000);
</script>

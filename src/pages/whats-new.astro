---
import Layout from '~/layouts/PageLayout.astro';

import Note from '~/components/widgets/Note.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';

import { newContent, sourceById, SITE } from '~/data/zzz';

const metadata = {
  title: 'What\'s New in ZZZ 3.3 "Journey to the Sky": Phoenix, Severian and Mech Combat',
  description:
    'A structured guide to Zenless Zone Zero Version 3.3 — new S-Rank Agents Phoenix and Severian, new W-Engines, mech combat, new events and areas, store additions and login rewards, sourced from the official update announcement.',
  ignoreTitleTemplate: true,
};

const updateNotice = sourceById('E02')!;
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6">
    <p class="text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200">Zenless Zone Zero 3.3</p>
    <h1 class="mt-2 max-w-4xl text-4xl font-bold leading-tight tracking-tighter text-heading md:text-5xl">
      What's new in Zenless Zone Zero Version 3.3
    </h1>
    <p class="mt-4 max-w-3xl text-xl text-muted">
      Version 3.3 “Journey to the Sky” adds two limited S-Rank Agents, three W-Engines, controllable mech combat, two
      new restricted areas and a full slate of events. This page is the update announcement written out in a readable
      order, with every line traced back to the official post.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-12 sm:px-6" id="agents">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">New S-Rank Agents in 3.3</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        newContent.agents.map((a) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{a.attribute}</p>
            <p class="mt-2 text-2xl font-bold text-heading">{a.title}</p>
            <p class="mt-1 text-sm font-medium text-primary dark:text-blue-300">{a.channel}</p>
            <p class="mt-3 text-muted">{a.blurb}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-muted">
      Both Agents are limited. Source:
      <a
        class="font-medium text-primary underline underline-offset-2 dark:text-blue-300"
        href={updateNotice.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {updateNotice.id} · {updateNotice.title}
      </a>
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="w-engines">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">New W-Engines</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        newContent.wEngines.map((w) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">{w.phase}</p>
            <p class="mt-2 text-lg font-bold text-heading">{w.name}</p>
            <p class="mt-1 text-sm text-muted">{w.attribute}</p>
          </div>
        ))
      }
    </div>

    <h3 class="mt-8 text-xl font-bold text-heading">New outfits</h3>
    <ul class="mt-3 grid gap-2 sm:grid-cols-3">
      {
        newContent.outfits.map((o) => (
          <li class="rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm dark:border-slate-700 dark:bg-slate-900">
            <span class="font-semibold text-heading">{o.name}</span>
            <span class="block text-muted">{o.owner}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="features">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">New events and gameplay</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        newContent.features.map((f) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
            <p class="text-lg font-bold text-heading">{f.title}</p>
            <p class="mt-2 text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">New areas</p>
        <ul class="mt-2 space-y-1 text-sm text-muted">
          {newContent.areas.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">Game modes</p>
        <ul class="mt-2 space-y-1 text-sm text-muted">
          {newContent.gameModes.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">Story</p>
        <p class="mt-2 text-sm text-muted">{newContent.story}</p>
      </div>
    </div>

    <h3 class="mt-8 text-xl font-bold text-heading">Event list</h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        newContent.events.map((e) => (
          <li class="rounded-full border border-gray-200 bg-white px-3 py-1 text-sm text-muted dark:border-slate-700 dark:bg-slate-900">
            {e}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="rewards">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">Login rewards and compensation</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 dark:border-slate-700">
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">Item</th>
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">Amount</th>
            <th scope="col" class="py-3 font-semibold text-heading">Condition</th>
          </tr>
        </thead>
        <tbody>
          {
            newContent.rewards.map((r) => (
              <tr class="border-b border-gray-100 dark:border-slate-800">
                <th scope="row" class="py-3 pr-4 align-top font-medium text-heading">
                  {r.label}
                </th>
                <td class="py-3 pr-4 align-top text-muted">{r.value}</td>
                <td class="py-3 align-top text-muted">{r.when}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6" id="store">
    <h2 class="text-3xl font-bold tracking-tight text-heading md:text-4xl">Store additions</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[40rem] text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 dark:border-slate-700">
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">Item</th>
            <th scope="col" class="py-3 pr-4 font-semibold text-heading">Price</th>
            <th scope="col" class="py-3 font-semibold text-heading">Availability</th>
          </tr>
        </thead>
        <tbody>
          {
            newContent.store.map((s) => (
              <tr class="border-b border-gray-100 dark:border-slate-800">
                <th scope="row" class="py-3 pr-4 align-top font-medium text-heading">
                  {s.item}
                </th>
                <td class="py-3 pr-4 align-top text-muted">{s.price}</td>
                <td class="py-3 align-top text-muted">{s.when}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="mt-6">
      <Note
        variant="info"
        title="Bundle and single-item discounts do not stack."
        description="The official store notice states that outfit bundle deals and individual item discounts are separate promotions and cannot be combined."
      />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6">
    <Content
      isReversed
      tagline="Where to go next"
      title="The dates behind this update"
      items={[
        {
          title: 'Banner phases',
          description: 'Phoenix and Velina close on November 11; Severian and the Phase II reruns take over.',
        },
        {
          title: 'Release time',
          description: 'The launch moment in 14 time zones, with the daylight saving offsets that apply.',
        },
        {
          title: 'Pre-download',
          description: 'The file sizes, the window and the compensation conditions.',
        },
      ]}
    >
      <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Content is only half of it</h3>
        <p>
          Most people who search for a version update are really asking two questions: what changed, and when does it
          land. This page answers the first. The countdown, the phase switches and the release time are on the other
          pages.
        </p>
      </Fragment>
    </Content>
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6">
    <Features
      tagline="Quick links"
      title="The rest of the 3.3 schedule"
      items={[
        {
          title: 'Countdown',
          description: 'Four timers: launch, Phase I end, Phase II end, version end.',
          icon: 'tabler:clock-hour-4',
        },
        { title: 'Release time', description: 'The same moments in 14 time zones.', icon: 'tabler:world' },
        { title: 'Banners', description: 'Every 3.3 channel with its own timer.', icon: 'tabler:repeat' },
        { title: 'Pre-download', description: 'Sizes, window and compensation rules.', icon: 'tabler:download' },
      ]}
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 mt-14 sm:px-6">
    <FAQs
      title="3.3 content FAQ"
      subtitle="The questions this update raises about the new Agents and the store."
      tagline="FAQ"
      items={[
        {
          title: 'Are Phoenix and Severian limited Agents?',
          description:
            'Both are limited S-Rank Agents obtained through Signal Search channels, and the official Phase I notice states that the limited S-Rank Agents and W-Engines in those channels do not become available in the Star-Studded Cast Stable Channel.',
        },
        {
          title: 'Which banner do Phoenix and Severian run in?',
          description:
            'Phoenix runs in the "Into the Flames of Life" Exclusive channel in Phase I, Severian in "Answers in the Wind" in Phase II.',
        },
        {
          title: 'When do the new outfits leave the shop?',
          description:
            'The "Empty Daydreams" bundle and the discounted Phoenix outfits are available until 2026/12/02 05:59 (UTC+8). After the discount ends, the individual outfits cost Monochrome x1,680.',
        },
        {
          title: 'Do the new agents come with a guarantee counter?',
          description:
            'The search count for guaranteed signals is cumulative across all Exclusive Channels in 3.3, but it is independent of other types of channels.',
        },
      ]}
    />
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-4 mt-10 sm:px-6">
    <Note
      variant="info"
      title="Every line on this page comes from the official update announcement."
      description={`Source: ${updateNotice.id} · ${updateNotice.title} — ${SITE.lastChecked}. ${SITE.disclaimer}`}
    />
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Open the live countdown',
        href: '/',
        icon: 'tabler:clock-hour-4',
      },
      { text: 'See the banner schedule', href: '/banners' },
    ]}
  >
    <Fragment slot="title">
      The update is live.<br class="block sm:hidden" />
      <span class="sm:whitespace-nowrap">The clock is not done</span>
    </Fragment>

    <Fragment slot="subtitle">
      Phase I ends November 11. Phase II ends with the banner cycle. Version 3.3 ends December 2.
    </Fragment>
  </CallToAction>
</Layout>

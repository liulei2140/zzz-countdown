---
import Layout from '~/layouts/PageLayout.astro';

import Note from '~/components/widgets/Note.astro';
import SectionArt from '~/components/widgets/SectionArt.astro';

import recordsArt from '~/assets/images/records-art.jpg';

const metadata = {
  title: 'Privacy Policy',
  description:
    'What ZZZ Countdown collects, which cookies the site uses, and how advertising and analytics are handled.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-4 pt-12 sm:px-6">
    <h1 class="text-4xl font-bold leading-tight tracking-tighter text-heading md:text-5xl">Privacy policy</h1>
    <p class="mt-4 text-xl text-muted">
      This site is a static set of pages with timers on them. It has no accounts, no comment system and no database of
      visitors.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 mt-10 sm:px-6">
    <SectionArt
      src={recordsArt.src}
      alt="Stacked translucent archive drawers with glowing index tabs"
      eyebrow="Privacy"
      heading="No accounts, no visitor database"
      caption="Original artwork for this site."
    />
  </section>

  <section class="mx-auto max-w-4xl px-4 mt-12 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight text-heading md:text-3xl">What we collect</h2>
    <div class="mt-4 space-y-4 text-lg text-muted">
      <p>
        We do not ask for names, email addresses or any other detail that identifies you. The countdown timers run
        entirely in your browser: your time zone is read from your device to show local times, and nothing about that is
        sent to us or stored.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 mt-12 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight text-heading md:text-3xl">Cookies and advertising</h2>
    <div class="mt-4 space-y-4 text-lg text-muted">
      <p>
        No advertising runs on this site at the moment, so no advertising network sets cookies here. If advertising is
        ever enabled, this section is updated to name the network and link to its own privacy policy before it goes
        live.
      </p>
      <p>We do not sell personal data and we do not build profiles of visitors for our own purposes.</p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 mt-12 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight text-heading md:text-3xl">Analytics</h2>
    <div class="mt-4 space-y-4 text-lg text-muted">
      <p>
        This site uses Google Analytics 4 (measurement ID <code>G-6S85YYNPTX</code>) to count visits and see which pages
        are read. Google Analytics records the page you opened, the site that referred you, and general information
        about the browser and device. It does not collect the countdown dates you read, and it never sees anything you
        type into the site.
      </p>
      <p>
        Google sets a first-party cookie named <code>_ga</code> to tell returning visitors apart. Google sets that cookie
        to expire after two years by default. Google's own policy covers the data it holds:
        <a
          class="font-medium text-primary underline underline-offset-2 dark:text-blue-300"
          href="https://policies.google.com/privacy">policies.google.com/privacy</a
        >.
      </p>
      <p>
        If you would rather not be measured, you can install the
        <a
          class="font-medium text-primary underline underline-offset-2 dark:text-blue-300"
          href="https://tools.google.com/dlpage/gaoptout">Google Analytics opt-out browser add-on</a
        >, or block analytics cookies with your browser's cookie controls.
      </p>
      <p>
        We read the reports to decide which pages to improve. We do not use them for advertising and we do not sell
        personal data.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 mt-12 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight text-heading md:text-3xl">Third-party links</h2>
    <div class="mt-4 space-y-4 text-lg text-muted">
      <p>
        Pages here link to HoYoverse announcements, the official press release, the Steam news feed and community
        resources. Those sites have their own privacy practices, which this policy does not cover.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 mt-12 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight text-heading md:text-3xl">Contact</h2>
    <div class="mt-4 space-y-4 text-lg text-muted">
      <p>
        Questions about this policy can go to the
        <a class="font-medium text-primary underline underline-offset-2 dark:text-blue-300" href="/contact"
          >contact page</a
        >.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-4 mt-10 sm:px-6">
    <Note
      variant="info"
      title="Last updated"
      description="October 21, 2026. This page is updated whenever the site's data practices change."
    />
  </section>
</Layout>
